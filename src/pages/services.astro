const metadata = {
  title: 'Our Services — USHA Consulting',
  description:
    "Safety, Environment & Industrial Hygiene services from USHA Consulting — Process Hazard Assessment, Risk Management, PSM, Audits, Training and more.",
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText
    tagline="What We Do"
    title="Our Services"
    classes={{ container: 'pb-0 md:pb-0' }}
  />

  <section class="services-page-wrap relative not-prose mx-auto max-w-7xl px-4 py-8 sm:px-6 md:py-10">
    <p class="mb-8 text-center text-lg text-muted dark:text-slate-400">
      Tap any service below to see what it covers and the full list of sub-services included under it.
    </p>

    <div class="services-grid" id="servicesGrid" aria-label="Service list">
      {services.map((service) => (
        <button
          type="button"
          class="service-card"
          data-target={`detail-${service.id}`}
          aria-expanded="false"
          aria-controls={`detail-${service.id}`}
        >
          <span class="card-icon" set:html={service.icon} />
          <h3>{service.title}</h3>
          <p>{service.summary}</p>
          <span class="card-cta">View details →</span>
        </button>
      ))}
    </div>

    <div class="service-detail-area" id="serviceDetailArea">
      <p class="detail-placeholder" id="detailPlaceholder">
        Select a service above to see the full scope of work and sub-services.
      </p>

      {services.map((service) => (
        <article class="detail-panel" id={`detail-${service.id}`} data-panel>
          <button type="button" class="detail-close" aria-label="Close service details">✕</button>
          <div class="detail-icon" set:html={service.icon} />
          <h2>{service.title}</h2>
          <p class="detail-description">{service.description}</p>
          <h3 class="sub-heading">What this covers</h3>
          <ul class="sub-list">
            {service.subServices.map((sub) => (
              <li>{sub}</li>
            ))}
          </ul>
          <a class="detail-cta" href="/contact">Ask us about this service →</a>
        </article>
      ))}
    </div>
  </section>

  <script>
    const detailArea = document.getElementById('serviceDetailArea');
    const placeholder = document.getElementById('detailPlaceholder');
    const cards = Array.from(document.querySelectorAll('.service-card'));
    const panels = Array.from(document.querySelectorAll('.detail-panel'));

    function closeAll() {
      panels.forEach((p) => p.classList.remove('is-visible'));
      cards.forEach((c) => {
        c.classList.remove('is-active');
        c.setAttribute('aria-expanded', 'false');
      });
      if (placeholder) placeholder.classList.remove('is-hidden');
    }

    function openPanel(targetId: string, sourceCard: Element) {
      panels.forEach((p) => p.classList.toggle('is-visible', p.id === targetId));
      cards.forEach((c) => {
        const isThis = c === sourceCard;
        c.classList.toggle('is-active', isThis);
        c.setAttribute('aria-expanded', String(isThis));
      });
      if (placeholder) placeholder.classList.add('is-hidden');
      if (detailArea) detailArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const targetId = (card as HTMLElement).dataset.target;
        if (!targetId) return;
        const alreadyOpen = card.classList.contains('is-active');
        if (alreadyOpen) {
          closeAll();
        } else {
          openPanel(targetId, card);
        }
      });
    });

    panels.forEach((panel) => {
      panel.querySelector('.detail-close')?.addEventListener('click', () => {
        closeAll();
      });
    });
  </script>

  <style>
    .services-page-wrap {
      --navy: #14264d;
      --teal: #0e7d82;
      --teal-light: #e7f5f5;
      --border: #e4e8ed;
      --radius: 14px;
    }

    :global(.dark) .services-page-wrap {
      --navy: #dbe4ff;
      --teal: #4fd1d9;
      --teal-light: rgba(79, 209, 217, 0.08);
      --border: #2a3346;
    }

    /* ---------- grid ---------- */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .service-card {
      text-align: left;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
      font-family: inherit;
    }

    .service-card:hover {
      box-shadow: 0 10px 24px rgba(20, 38, 77, 0.09);
      transform: translateY(-2px);
      border-color: var(--teal);
    }

    .service-card:focus-visible {
      outline: 2px solid var(--teal);
      outline-offset: 2px;
    }

    .service-card.is-active {
      border-color: var(--teal);
      background: var(--teal-light);
    }

    .card-icon {
      width: 44px;
      height: 44px;
      color: var(--navy);
      margin-bottom: 0.5rem;
    }

    .card-icon svg {
      width: 100%;
      height: 100%;
    }

    .service-card h3 {
      margin: 0;
      font-size: 1.15rem;
      color: var(--navy);
    }

    .service-card p {
      margin: 0;
      color: inherit;
      opacity: 0.75;
      font-size: 0.94rem;
      line-height: 1.5;
    }

    .card-cta {
      margin-top: 0.6rem;
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--teal);
    }

    /* ---------- detail area ---------- */
    .service-detail-area {
      margin-top: 2.5rem;
      min-height: 4rem;
    }

    .detail-placeholder {
      color: inherit;
      opacity: 0.65;
      font-size: 0.98rem;
      text-align: center;
      padding: 2rem 1rem;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
    }

    .detail-placeholder.is-hidden {
      display: none;
    }

    .detail-panel {
      display: none;
      position: relative;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2.5rem;
      box-shadow: 0 16px 40px rgba(20, 38, 77, 0.1);
    }

    .detail-panel.is-visible {
      display: block;
      animation: fadeIn 0.22s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .detail-close {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      border: none;
      background: transparent;
      font-size: 1.2rem;
      line-height: 1;
      color: inherit;
      opacity: 0.6;
      cursor: pointer;
      padding: 0.35rem;
      border-radius: 50%;
    }

    .detail-close:hover {
      background: var(--teal-light);
      color: var(--navy);
      opacity: 1;
    }

    .detail-icon {
      width: 52px;
      height: 52px;
      color: var(--teal);
      margin-bottom: 1rem;
    }

    .detail-icon svg {
      width: 100%;
      height: 100%;
    }

    .detail-panel h2 {
      margin: 0 0 0.75rem;
      color: var(--navy);
      font-size: 1.6rem;
    }

    .detail-description {
      color: inherit;
      opacity: 0.85;
      font-size: 1.02rem;
      line-height: 1.65;
      margin: 0 0 1.75rem;
      max-width: 68ch;
    }

    .sub-heading {
      margin: 0 0 0.9rem;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--teal);
    }

    .sub-list {
      list-style: none;
      margin: 0 0 2rem;
      padding: 0;
      display: grid;
