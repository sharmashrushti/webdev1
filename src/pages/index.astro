---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'USHA Consulting — HSE, Safety & Industrial Hygiene Consulting',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    classes={{ container: 'pb-0 md:pb-0' }}
    actions={[
      { variant: 'primary', text: 'Get in Touch', href: '/contact' },
      { text: 'Our Services', href: '/services' },
    ]}
  >
    <Fragment slot="title">
      HSE Consulting You Can <span class="text-accent dark:text-white">Trust</span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="font-semibold">USHA Consulting</span> delivers specialized Safety, Environment &amp;
      Industrial Hygiene, and Electrical Safety consulting for chemical, pharmaceutical, oil &amp; gas,
      and industrial clients across India. 200+ projects executed. 30 years of hands-on HSE expertise.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->
  <Stats
    classes={{ container: 'py-8 md:py-10' }}
    stats={[
      { title: 'Projects Executed', amount: '200+' },
      { title: 'Years of HSE Experience', amount: '30' },
      { title: 'PHA Studies Facilitated', amount: '250+' },
      { title: 'Training Man-Hours Delivered', amount: '1200+' },
    ]}
  />

  <!-- Features Widget: Services ***** -->
  <Features
    id="services"
    tagline="What We Do"
    title="Our Services"
    subtitle="Comprehensive HSE consulting built on decades of hands-on industrial experience."
    classes={{ container: 'pt-0 md:pt-0 lg:pt-0 pb-8 md:pb-10' }}
    items={[
      {
        title: 'Process Hazard Assessment',
        description: 'HAZOP, HAZID, LOPA, BowTie, HIRA, and Dust Hazard Assessment studies led by an experienced PHA facilitator.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Process Safety Management',
        description: 'PSM implementation as per OSHA 29 CFR 1910.119 or CCPS standards, from gap assessment through handholding.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Audits',
        description: '300+ safety, environmental, fire, electrical, and legal compliance audits across process and manufacturing sites.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Risk Management',
        description: 'Hazardous area classification, pre-start-up safety reviews, and layout &amp; facility siting studies.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Training',
        description: '1,200+ hours of HSE, PSM, HAZOP, and construction safety training delivered in-company, online, and face-to-face.',
        icon: 'tabler:school',
      },
      {
        title: 'Industrial Hygiene',
        description: 'Chemical risk assessment and qualitative exposure assessment for industrial workplaces.',
        icon: 'tabler:flask',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- Content Widget: About preview ** -->
  <Content
    isReversed
    tagline="Who We Are"
    title="30 Years of HSE Expertise"
    classes={{ container: 'py-8 md:py-10' }}
    image={{
      src: '~/assets/images/logo.png',
      alt: 'Usha Consulting',
    }}
    items={[
      {
        title: 'Qualified & certified',
        description: 'Chemical Engineer with a diploma in Industrial Safety and a NEBOSH International General Certificate in Occupational Health & Safety.',
      },
      {
        title: 'Cross-industry experience',
        description: 'Construction, consultancy, oil & gas, FMCG, and chemical industries — including 6 years as a Utility Engineer.',
      },
      {
        title: 'Certified auditor',
        description: 'ISO 9001:2015, ISO 14001:2015, ISO 45001:2015, CE marking (PPE), and approved Pharmaceutical Supply Chain Initiative (PSCI) auditor.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Based in Pune, working nationwide</h3>
      Incorporated in October 2020, USHA Consulting has executed more than 200 projects across chemical, pharmaceutical,
      agrochemical, oil &amp; gas, steel, and power sectors in the last four years alone.
    </Fragment>
  </Content>

  <!-- Features3 Widget: Sectors ***** -->
  <Features3
    tagline="Who We Work With"
    title="Sectors We Serve"
    subtitle="From bulk chemistry to city gas distribution — HSE consulting across process and industrial sectors."
    columns={3}
    classes={{ container: 'py-8 md:py-10' }}
    items={[
      { title: 'Chemical Industry', description: 'Bulk chemistry and fine chemistry manufacturing.', icon: 'tabler:flask-2' },
      { title: 'Pharmaceuticals', description: 'API manufacturing and formulation units.', icon: 'tabler:pill' },
      { title: 'Agrochemicals', description: 'Pesticide, insecticide, and herbicide manufacturing.', icon: 'tabler:seeding' },
      { title: 'Oil & Gas', description: 'City gas distribution, cross-country pipelines, and petrochemicals.', icon: 'tabler:gas-station' },
      { title: 'Power Generation', description: 'Thermal, gas-based, and captive power plants.', icon: 'tabler:bolt' },
      { title: 'Steel & Aluminium', description: 'Integrated steel plants and metal manufacturing.', icon: 'tabler:building-factory-2' },
      { title: 'Logistics & Warehousing', description: 'Warehouse and distribution network safety audits.', icon: 'tabler:truck' },
      { title: 'Construction', description: 'Industrial, metro, and road projects.', icon: 'tabler:crane' },
      { title: 'Cosmetics & FMCG, Education, and more', description: 'Cosmetic manufacturing, consumer goods, education, and other process industries.', icon: 'tabler:building-store' },
    ]}
  />

  <!-- FAQs Widget ******************* -->
  <FAQs
    title="Frequently Asked Questions"
    subtitle="Common questions about our HSE consulting services."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl py-8 md:py-10' }}
    items={[
      {
        title: 'What industries do you work with?',
        description:
          'We work across chemical, pharmaceutical, agrochemical, cosmetic, oil & gas, power generation, steel, logistics, construction, and other process industries.',
      },
      {
        title: 'Do you conduct HAZOP and PHA studies?',
        description:
          'Yes — we have facilitated 250+ Process Hazard Analysis studies including HAZOP, HAZID, BowTie, HIRA, and Dust Hazard Assessment across pharmaceutical, chemical, and specialty manufacturing sites.',
      },
      {
        title: 'Can you help with PSM implementation?',
        description:
          'Yes — we implement Process Safety Management as per OSHA 29 CFR 1910.119 (14 elements) or CCPS (20 elements), from gap assessment through phased rollout and handholding.',
      },
      {
        title: 'Do you offer on-site training?',
        description:
          'We deliver in-company and open training courses, both face-to-face and via webinar, for managers, engineers, and operators, with customized programs on request.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    classes={{ container: 'pt-0 md:pt-0' }}
    actions={[
      { variant: 'primary', text: 'Contact Us', href: '/contact' },
    ]}
  >
    <Fragment slot="title">
      Let's talk about your <br class="block sm:hidden" /><span class="sm:whitespace-nowrap"> requirements</span>
    </Fragment>
    <Fragment slot="subtitle">
      Get in touch to discuss audits, training, PHA studies, or PSM implementation for your site.
    </Fragment>
  </CallToAction>
</Layout>
